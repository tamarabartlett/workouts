# Copy to .env.local for local development (see README).
# On Vercel, set these in Project → Settings → Environment Variables.

# Login (bcrypt hash: npm run hash-password -- "your-password")
ALLOWED_USERNAME=
ALLOWED_PASSWORD_HASH=

# Random string, 32+ characters (e.g. openssl rand -base64 32)
SESSION_SECRET=

# MongoDB Atlas connection string
MONGODB_URI=

# Optional: Angular dev server origin for API CORS (default http://localhost:4200)
# CORS_ORIGIN=http://localhost:4200
